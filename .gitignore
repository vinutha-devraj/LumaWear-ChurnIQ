# ==============================
# LumaWear + ChurnIQ Root Ignore
# ==============================

# Node
**/node_modules/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
**/.env
**/.env.*
!.env.example

# Python
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Backups
LumaWear-Ecommerce_backup/
ChurnProject_backup/

# LumaWear generated/local data
LumaWear-Ecommerce/backend/data/
!LumaWear-Ecommerce/backend/data/.gitkeep

# ChurnIQ large generated model artifacts
ChurnProject/artifacts/**/*.joblib
!ChurnProject/artifacts/2b2147fd4057/churn_pipeline.joblib
!ChurnProject/artifacts/2b2147fd4057/shap_explainer.joblib

# Temporary/test-generated data
ChurnProject/data/test_telecom.csv

# Local IDE
.vscode/
.idea/

ChurnProject/data/test_ecomm2.csv

LumaWear-Ecommerce/backend/*-backup-*.json
